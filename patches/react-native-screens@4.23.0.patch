index 1c447628d505fbf1bc0c296aee1b6d78321f4559..27c4875d0d0d8dfefdf8dc4716bd5c86b5d34d29 100644
--- a/ios/RNSScreen.mm
+++ b/ios/RNSScreen.mm
@@ -241,6 +241,13 @@ RNS_IGNORE_SUPER_CALL_END
 
 - (void)applyFrameCorrectionForDescendantScrollView
 {
+  // Backport of upstream #4652: a deleted sheet must not resize a recycled scroll view.
+  // In 4.23 invalidateImpl clears the controller, which is our invalidation marker.
+  // Upstream commit: 8b2163ba587a99eaba81aba09eb0e1153c028ade.
+  if (_controller == nil) {
+    return;
+  }
+
   RNS_REACT_SCROLL_VIEW_COMPONENT *scrollView = [self tryFindDescendantScrollView];
   if (_sheetsScrollView != scrollView) {
     [_sheetsScrollView removeObserver:self forKeyPath:@"bounds" context:nil];
@@ -278,6 +285,12 @@ RNS_IGNORE_SUPER_CALL_END
     return;
   }
 
+  // A removed sheet may still observe a scroll view recycled into another screen.
+  // Never resize content that no longer belongs to this screen.
+  if (![scrollView isDescendantOfView:self]) {
+    return;
+  }
+
   RNSScreenContentWrapper *_Nullable contentWrapper = _contentWrapperBox.contentWrapper;
   if (contentWrapper != nil && [contentWrapper coerceChildScrollViewComponentSizeToSize:self.frame.size]) {
     return;
