diff --git a/dist/hooks/useImageLoad.js b/dist/hooks/useImageLoad.js
new file mode 100644
index 0000000000000000000000000000000000000000..e1585b776970dc13507761d4b9e4c36e616c07d7
--- /dev/null
+++ b/dist/hooks/useImageLoad.js
@@ -0,0 +1,27 @@
+import { useEffect, useMemo, useState } from "react";
+import useImageDimensions from "./useImageDimensions";
+
+const useImageLoad = (image) => {
+    const [attempt, setAttempt] = useState(0);
+    const owner = useMemo(() => ({ active: true }), [image, attempt]);
+    const [result, setResult] = useState(null);
+    const dimensions = useImageDimensions(image, attempt);
+    useEffect(() => { owner.active = true; return () => { owner.active = false; }; }, [owner]);
+    const failed = (result?.owner === owner && result.failed) ||
+        (dimensions !== null && (dimensions.width <= 0 || dimensions.height <= 0));
+    return {
+        dimensions,
+        attempt,
+        failed,
+        loaded: !failed && result?.owner === owner && result.loaded && dimensions !== null,
+        onLoad: () => {
+            if (owner.active) setResult(previous => previous?.owner === owner && previous.failed
+                ? previous : { owner, loaded: true, failed: false });
+        },
+        onError: () => {
+            if (owner.active) setResult({ owner, loaded: false, failed: true });
+        },
+        retry: () => { if (owner.active) setAttempt(value => value + 1); },
+    };
+};
+export default useImageLoad;
