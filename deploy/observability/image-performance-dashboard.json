{
  "uid": "stuffstash-image-performance",
  "title": "Stuff Stash \u00b7 Image performance",
  "schemaVersion": 39,
  "version": 0,
  "tags": [
    "stuffstash",
    "media",
    "observability"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics source",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "$metrics"
        },
        "query": {
          "query": "label_values(stuffstash_operation_duration_seconds_count, job)",
          "refId": "service"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP response latency",
      "description": "Includes authorization, application work and response writes. WebSocket duration is session lifetime.",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(stuffstash_operation_duration_seconds_bucket{job=~\"$service\",operation=\"http.request\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stuffstash_operation_duration_seconds_bucket{job=~\"$service\",operation=\"http.request\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(stuffstash_operation_duration_seconds_bucket{job=~\"$service\",operation=\"http.request\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 by route",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,http_route) (rate(stuffstash_operation_duration_seconds_bucket{job=~\"$service\",operation=\"http.request\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Dependency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,operation) (rate(stuffstash_operation_duration_seconds_bucket{job=~\"$service\",operation!=\"http.request\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Operation throughput",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation) (rate(stuffstash_operation_duration_seconds_count{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "range": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP failures",
      "description": "Includes 4xx, 5xx and interrupted handlers. No traffic yields no ratio.",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(stuffstash_operation_duration_seconds_count{job=~\"$service\",operation=\"http.request\",outcome!=\"success\"}[$__rate_interval])) / sum(rate(stuffstash_operation_duration_seconds_count{job=~\"$service\",operation=\"http.request\"}[$__rate_interval]))",
          "legendFormat": "failed / all",
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Thumbnail responses by source",
      "description": "Successful responses, not distinct generation jobs. Singleflight followers count as generated responses.",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source,variant) (rate(stuffstash_media_thumbnail_served_total{job=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{variant}} \u00b7 {{source}}",
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Go heap objects",
      "description": "Live or not-yet-swept Go heap objects. This is not container RSS.",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stuffstash_go_heap_objects_bytes{job=~\"$service\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Go allocation rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(stuffstash_go_heap_allocated_bytes_total{job=~\"$service\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Go goroutines",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stuffstash_go_goroutines{job=~\"$service\"}",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Go GC cycles",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(stuffstash_go_gc_cycles_total{job=~\"$service\"}[$__rate_interval])",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Failed telemetry export batches",
      "description": "Transport failures after retry. These counters do not include SDK queue overflow; an unavailable metrics collector may hide its own failures. Check API logs too.",
      "datasource": {
        "type": "prometheus",
        "uid": "$metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(stuffstash_telemetry_dropped_batches_total{job=~\"$service\"}[$__range])",
          "legendFormat": "{{signal}} \u00b7 {{instance}}",
          "range": true
        }
      ]
    }
  ]
}
